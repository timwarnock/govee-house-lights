[Unit]
Description=House lights
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
ExecStart=@BIN@ daemon --config %h/.config/house-lights/config.json --state %h/.local/state/house-lights/daemon.json
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=default.target
