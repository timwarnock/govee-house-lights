[Unit]
Description=House lights
After=bluetooth.target
Wants=bluetooth.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=@BIN@ daemon --config @ROOT@/config.json --desired-state @ROOT@/desired-state --state @ROOT@/desired-state/daemon.json
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
